@startuml class-diagram
title BrewLite Assignment 2 — Biểu Đồ Lớp Hệ Thống (Prisma Entities, Enums & Core Services)

top to bottom direction
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 50

skinparam classFontColor #FFFFFF
skinparam classStereotypeFontColor #E2E8F0
skinparam stereotypeFontColor #E2E8F0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    HeaderBackgroundColor #1A365D
    HeaderFontColor #FFFFFF
    ArrowColor #334155
    ArrowFontColor #334155
}

skinparam enum {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    HeaderBackgroundColor #1A365D
    HeaderFontColor #FFFFFF
}

skinparam note {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
}

' ==========================================================
' 1. ENUMS TRẠNG THÁI & PHÂN LOẠI (Prisma Schema)
' ==========================================================
package "Domain Enums (Prisma Schema)" #F1F5F9 {
    enum Role {
        CUSTOMER
        ADMIN
        BARISTA
    }

    enum OrderStatus {
        PENDING
        PAID
        PREPARING
        READY
        COMPLETED
        PAYMENT_FAILED
        CANCELLED
    }

    enum PaymentStatus {
        PENDING
        SUCCESS
        FAILED
    }

    enum PaymentMethod {
        E_WALLET
        BANK_CARD
    }

    enum PaymentGateway {
        MOCK
        VNPAY
    }

    enum ProductSize {
        S
        M
        L
    }

    enum LoyaltyTransactionType {
        EARNED
        SPENT
        REFUNDED
    }
}

' ==========================================================
' 2. CORE ENTITIES (KHỚP TRỰC TIẾP schema.prisma)
' ==========================================================
package "Core Domain Entities (PostgreSQL / Prisma Models)" #F8FAFC {
    class User <<model>> {
        + id : String <<PK, cuid>>
        + email : String <<UK>>
        + passwordHash : String
        + fullName : String?
        + role : Role = CUSTOMER
        + loyaltyPoints : Int = 0
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Product <<model>> {
        + id : String <<PK, cuid>>
        + categoryId : String? <<FK>>
        + name : String
        + basePrice : Decimal(12,0)
        + imageUrl : String?
        + stock : Int <<deprecated CR-01>>
        + version : Int <<deprecated CR-01>>
        + isAvailable : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Promotion <<model>> {
        + id : String <<PK, cuid>>
        + code : String <<UK>>
        + description : String?
        + discountPercent : Int?
        + discountAmount : Decimal(12,0)?
        + maxDiscount : Decimal(12,0)?
        + minOrderAmount : Decimal(12,0) = 0
        + startDate : DateTime
        + endDate : DateTime?
        + isActive : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Order <<model>> {
        + id : String <<PK, cuid>>
        + orderNumber : Int <<UK, autoincrement>>
        + userId : String <<FK>>
        + promotionId : String? <<FK>>
        + status : OrderStatus = PENDING
        + totalAmount : Decimal(12,0)
        + discountAmount : Decimal(12,0) = 0
        + finalAmount : Decimal(12,0)
        + pointsEarned : Int = 0
        + paidAt : DateTime?
        + version : Int = 0 <<OptimisticLock>>
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class OrderItem <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + productId : String <<FK>>
        + size : ProductSize = M
        + quantity : Int = 1
        + unitPrice : Decimal(12,0)
        + lineTotal : Decimal(12,0)
    }

    class Payment <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + idempotencyKey : String <<UK>>
        + requestHash : String?
        + amount : Decimal(12,0)
        + method : PaymentMethod
        + gateway : PaymentGateway = MOCK
        + status : PaymentStatus = PENDING
        + failureReason : String?
        + transactionRef : String?
        + gatewayTransactionNo : String?
        + paymentUrl : String?
        + createdAt : DateTime
    }

    class LoyaltyTransaction <<model>> {
        + id : String <<PK, cuid>>
        + userId : String <<FK>>
        + orderId : String? <<FK>>
        + points : Int
        + type : LoyaltyTransactionType
        + reason : String
        + createdAt : DateTime
    }
}

' ==========================================================
' 3. CORE APPLICATION SERVICES (NestJS Providers)
' ==========================================================
package "Core Backend Services (NestJS)" #EFF6FF {
    class PrismaClient <<external>> {
        + $connect() : Promise<void>
        + $disconnect() : Promise<void>
        + $transaction(fn) : Promise<T>
    }

    class PrismaService <<service>> {
        + onModuleInit() : Promise<void>
        + onModuleDestroy() : Promise<void>
    }

    class AuthService <<service>> {
        + register(dto: RegisterDto) : Promise<AuthResult>
        + login(dto: LoginDto) : Promise<AuthResult>
    }

    class ProductDetailService <<service>> {
        + getProductById(id: string) : Promise<ProductDetailDto>
    }

    class PricingService <<service>> {
        + calculate(items: PricingItemInput[]) : Promise<PricingResult>
    }

    class PromotionsService <<service>> {
        + validate(code: string, totalAmount: number) : Promise<PromotionResult?>
    }

    class OrdersService <<service>> {
        + create(userId: string, dto: CreateOrderDto) : Promise<Order>
    }

    class OrderService <<service>> {
        + transition(tx, orderId: string, to: OrderStatus, opts?) : Promise<Order>
    }

    class PaymentsService <<service>> {
        + createPayment(userId: string, key: string, dto: CreatePaymentDto, mockOutcome?) : Promise<PaymentResponse>
        + handleVnpayIpn(query: Record<string, string>) : Promise<VnpayIpnResponse>
        + getPaymentById(userId: string, paymentId: string) : Promise<PaymentResponse>
    }

    class LoyaltyService <<service>> {
        + award(tx, order: { id, userId, finalAmount }) : Promise<void>
    }
}

' ==========================================================
' 4. QUAN HỆ KẾ THỪA THỰC TẾ TRONG CODE (INHERITANCE)
' ==========================================================
PrismaClient <|-- PrismaService : extends

' ==========================================================
' 5. QUAN HỆ GIỮA CÁC ENTITY (COMPOSITION, AGGREGATION, ASSOCIATION)
' ==========================================================
' Composition (*--): Tồn tại phụ thuộc chặt vào cha (onDelete: Cascade)
Order "1" *-- "1..*" OrderItem : contains >
Order "1" *-- "0..*" Payment : paid by >

' Aggregation (o--): Sở hữu yếu, vòng đời độc lập
Promotion "0..1" o-- "0..*" Order : applies to >
User "1" o-- "0..*" LoyaltyTransaction : owns >

' Association (--> / <--): Liên kết nghiệp vụ chuẩn
User "1" --> "0..*" Order : places >
Product "1" <-- "0..*" OrderItem : references <
Order "0..1" <-- "0..*" LoyaltyTransaction : awards / refunds <

' ==========================================================
' 6. TƯƠNG TÁC SERVICE & ENTITY
' ==========================================================
OrdersService --> PricingService : calculates prices
OrdersService --> PromotionsService : validates voucher
OrdersService --> PrismaService : uses $transaction
PaymentsService --> OrderService : transitions status
PaymentsService --> LoyaltyService : awards points
PaymentsService --> PrismaService : reads/writes payments

AuthService ..> User : manages
ProductDetailService ..> Product : queries
PricingService ..> Product : reads DB prices
PromotionsService ..> Promotion : validates
OrdersService ..> Order : creates
OrderService ..> Order : updates status & version
PaymentsService ..> Payment : records & replays
LoyaltyService ..> LoyaltyTransaction : logs points

note bottom of OrderService
  Invariant: Duy nhất OrderService.transition()
  được phép cập nhật Order.status (Optimistic Lock).
end note

note bottom of PricingService
  Invariant: Toàn bộ giá do PricingService
  tính độc lập từ DB, bỏ qua giá từ Client.
end note
@enduml
