@startuml class-diagram
title BrewLite Assignment 2 — Biểu Đồ Lớp Hệ Thống (Toàn Bộ 16 Prisma Models, 7 Enums & Backend Services)

top to bottom direction
skinparam shadowing false
skinparam roundcorner 8
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 38
skinparam ranksep 45

skinparam classFontColor #FFFFFF
skinparam classStereotypeFontColor #E2E8F0
skinparam stereotypeFontColor #E2E8F0

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    HeaderBackgroundColor #1A365D
    HeaderFontColor #FFFFFF
    ArrowColor #334155
    ArrowFontColor #334155
}

skinparam enum {
    BackgroundColor #FFFFFF
    BorderColor #2B6CB0
    HeaderBackgroundColor #1A365D
    HeaderFontColor #FFFFFF
}

skinparam note {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
}

' ==========================================================
' 1. DOMAIN ENUMS (KHỚP schema.prisma)
' ==========================================================
package "Domain Enums (Prisma Schema)" #F1F5F9 {
    enum Role {
        CUSTOMER
        ADMIN
        BARISTA
    }

    enum OrderStatus {
        PENDING
        PAID
        PREPARING
        READY
        COMPLETED
        PAYMENT_FAILED
        CANCELLED
    }

    enum PaymentStatus {
        PENDING
        SUCCESS
        FAILED
    }

    enum PaymentMethod {
        E_WALLET
        BANK_CARD
    }

    enum PaymentGateway {
        MOCK
        VNPAY
    }

    enum ProductSize {
        S
        M
        L
    }

    enum LoyaltyTransactionType {
        EARNED
        SPENT
        REFUNDED
    }
}

' ==========================================================
' 2. DOMAIN ENTITIES (ĐỦ 16 PRISMA MODELS TRONG schema.prisma)
' ==========================================================
package "Domain Entities (PostgreSQL / Prisma Models)" #F8FAFC {
    class User <<model>> {
        + id : String <<PK, cuid>>
        + email : String <<UK>>
        + passwordHash : String
        + fullName : String?
        + role : Role = CUSTOMER
        + loyaltyPoints : Int = 0
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Category <<model>> {
        + id : String <<PK, cuid>>
        + name : String <<UK>>
        + slug : String <<UK>>
        + displayOrder : Int = 0
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Product <<model>> {
        + id : String <<PK, cuid>>
        + categoryId : String? <<FK>>
        + name : String
        + basePrice : Decimal(12,0)
        + imageUrl : String?
        + stock : Int <<deprecated CR-01>>
        + version : Int <<deprecated CR-01>>
        + isAvailable : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class ProductSizePrice <<model>> {
        + id : String <<PK, cuid>>
        + productId : String <<FK>>
        + size : ProductSize
        + priceAdjustment : Decimal(12,0) = 0
    }

    class Topping <<model>> {
        + id : String <<PK, cuid>>
        + name : String <<UK>>
        + price : Decimal(12,0)
        + stock : Int <<deprecated CR-01>>
        + isAvailable : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Promotion <<model>> {
        + id : String <<PK, cuid>>
        + code : String <<UK>>
        + description : String?
        + discountPercent : Int?
        + discountAmount : Decimal(12,0)?
        + maxDiscount : Decimal(12,0)?
        + minOrderAmount : Decimal(12,0) = 0
        + startDate : DateTime
        + endDate : DateTime?
        + isActive : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class Order <<model>> {
        + id : String <<PK, cuid>>
        + orderNumber : Int <<UK, autoincrement>>
        + userId : String <<FK>>
        + promotionId : String? <<FK>>
        + status : OrderStatus = PENDING
        + totalAmount : Decimal(12,0)
        + discountAmount : Decimal(12,0) = 0
        + finalAmount : Decimal(12,0)
        + pointsEarned : Int = 0
        + paidAt : DateTime?
        + version : Int = 0 <<OptimisticLock>>
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class OrderItem <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + productId : String <<FK>>
        + size : ProductSize = M
        + quantity : Int = 1
        + unitPrice : Decimal(12,0)
        + lineTotal : Decimal(12,0)
    }

    class OrderItemTopping <<model>> {
        + id : String <<PK, cuid>>
        + orderItemId : String <<FK>>
        + toppingId : String <<FK>>
        + price : Decimal(12,0)
    }

    class Payment <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + idempotencyKey : String <<UK>>
        + requestHash : String?
        + amount : Decimal(12,0)
        + method : PaymentMethod
        + gateway : PaymentGateway = MOCK
        + status : PaymentStatus = PENDING
        + failureReason : String?
        + transactionRef : String?
        + gatewayTransactionNo : String?
        + paymentUrl : String?
        + createdAt : DateTime
    }

    class LoyaltyTransaction <<model>> {
        + id : String <<PK, cuid>>
        + userId : String <<FK>>
        + orderId : String? <<FK>>
        + points : Int
        + type : LoyaltyTransactionType
        + reason : String
        + createdAt : DateTime
    }

    class OrderStatusHistory <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + fromStatus : OrderStatus?
        + toStatus : OrderStatus
        + changedBy : String?
        + reason : String?
        + createdAt : DateTime
    }

    class Ingredient <<model>> {
        + id : String <<PK, cuid>>
        + name : String <<UK>>
        + unit : String
        + stock : Int = 0
        + minThreshold : Int = 50
        + isAvailable : Boolean = true
        + createdAt : DateTime
        + updatedAt : DateTime
    }

    class ProductRecipe <<model>> {
        + id : String <<PK, cuid>>
        + productId : String <<FK>>
        + size : ProductSize = M
        + ingredientId : String <<FK>>
        + quantity : Int
    }

    class ToppingRecipe <<model>> {
        + id : String <<PK, cuid>>
        + toppingId : String <<FK>>
        + ingredientId : String <<FK>>
        + quantity : Int
    }

    class OrderIngredientUsage <<model>> {
        + id : String <<PK, cuid>>
        + orderId : String <<FK>>
        + ingredientId : String <<FK>>
        + quantity : Int
    }
}

' ==========================================================
' 3. BACKEND SERVICES & HELPERS (ĐỦ CÁC SERVICE TRONG apps/api/src)
' ==========================================================
package "Backend Services & Helpers (NestJS)" #EFF6FF {
    class PrismaClient <<external>> {
        + $connect() : Promise<void>
        + $disconnect() : Promise<void>
        + $transaction(fn) : Promise<T>
    }

    class PrismaService <<service>> {
        + onModuleInit() : Promise<void>
        + onModuleDestroy() : Promise<void>
    }

    class AuthService <<service>> {
        + register(dto: RegisterDto) : Promise<AuthResult>
        + login(dto: LoginDto) : Promise<AuthResult>
    }

    class ProductsService <<service>> {
        + getProducts() : Promise<ProductItem[]>
    }

    class ProductDetailService <<service>> {
        + getProductById(id: string) : Promise<ProductDetailDto>
    }

    class PricingService <<service>> {
        + calculate(items: PricingItemInput[]) : Promise<PricingResult>
    }

    class PromotionsService <<service>> {
        + validate(code: string, totalAmount: number) : Promise<PromotionResult?>
    }

    class OrdersService <<service>> {
        + create(userId: string, dto: CreateOrderDto) : Promise<Order>
    }

    class OrderService <<service>> {
        + transition(tx, orderId: string, to: OrderStatus, opts?) : Promise<Order>
    }

    class CancelOrderService <<service>> {
        + cancel(orderId: string, userId: string) : Promise<CancelOrderResult>
    }

    class HistoryService <<service>> {
        + findAll(userId: string, query?: GetOrderHistoryDto) : Promise<OrderHistoryResult>
        + findOne(userId: string, orderId: string) : Promise<OrderDetail>
    }

    class AdminOrdersService <<service>> {
        + findActive() : Promise<AdminOrder[]>
        + advance(orderId: string, toStatus: OrderStatus, adminId: string) : Promise<Order>
    }

    class PaymentsService <<service>> {
        + createPayment(userId: string, key: string, dto: CreatePaymentDto, mockOutcome?) : Promise<PaymentResponse>
        + handleVnpayIpn(query: Record<string, string>) : Promise<VnpayIpnResponse>
        + getPaymentById(userId: string, paymentId: string) : Promise<PaymentResponse>
    }

    class MockGatewayService <<service>> {
        + processPayment(outcomeHeader?: string) : MockPaymentOutcome
    }

    class VnpayGatewayService <<service>> {
        + getCredentials() : VnpayCredentials
        + createPaymentUrl(params) : string
        + verifyIpnSignature(query) : boolean
    }

    class LoyaltyService <<service>> {
        + award(tx, order: { id, userId, finalAmount }) : Promise<void>
    }

    class IngredientStockHelper <<helper>> {
        + deductIngredients(tx, demands: IngredientDemand[]) : Promise<void>
        + restoreIngredients(tx, usages: IngredientUsage[]) : Promise<void>
    }
}

' ==========================================================
' 4. QUAN HỆ KẾ THỪA THỰC TẾ (INHERITANCE)
' ==========================================================
PrismaClient <|-- PrismaService : extends

' ==========================================================
' 5. QUAN HỆ GIỮA 16 ENTITY (COMPOSITION, AGGREGATION, ASSOCIATION)
' ==========================================================
' Composition (*--): onDelete: Cascade
Product "1" *-- "1..*" ProductSizePrice : has prices >
Product "1" *-- "0..*" ProductRecipe : uses recipe >
Topping "1" *-- "0..*" ToppingRecipe : uses recipe >
Order "1" *-- "1..*" OrderItem : contains >
Order "1" *-- "0..*" Payment : paid by >
Order "1" *-- "0..*" OrderStatusHistory : logs >
Order "1" *-- "0..*" OrderIngredientUsage : consumes >
OrderItem "1" *-- "0..*" OrderItemTopping : includes >

' Aggregation (o--): vòng đời độc lập
Category "0..1" o-- "0..*" Product : categorizes >
Promotion "0..1" o-- "0..*" Order : applies to >
User "1" o-- "0..*" LoyaltyTransaction : owns >

' Association (--> / <--): liên kết tham chiếu
User "1" --> "0..*" Order : places >
Product "1" <-- "0..*" OrderItem : references <
Topping "1" <-- "0..*" OrderItemTopping : snapshots <
Order "0..1" <-- "0..*" LoyaltyTransaction : awards / refunds <
Ingredient "1" <-- "0..*" ProductRecipe : required by <
Ingredient "1" <-- "0..*" ToppingRecipe : required by <
Ingredient "1" <-- "0..*" OrderIngredientUsage : deducted from <

' ==========================================================
' 6. TƯƠNG TÁC SERVICE & ENTITY
' ==========================================================
OrdersService --> PricingService : delegates pricing
OrdersService --> PromotionsService : validates voucher
OrdersService --> IngredientStockHelper : deducts ingredients
OrdersService --> PrismaService : uses $transaction
PaymentsService --> OrderService : transition(PENDING -> PAID/FAILED)
PaymentsService --> LoyaltyService : awards points
PaymentsService --> MockGatewayService : mock gateway
PaymentsService --> VnpayGatewayService : VNPay gateway
PaymentsService --> PrismaService : reads/writes payments
CancelOrderService --> OrderService : transition(CANCELLED)
CancelOrderService --> IngredientStockHelper : restores snapshot once on CANCELLED
AdminOrdersService --> OrderService : transition(PAID -> PREPARING -> READY -> COMPLETED)

AuthService ..> User : manages
ProductsService ..> Product : lists available
ProductDetailService ..> Product : queries detail & toppings
PricingService ..> Product : reads DB prices
PromotionsService ..> Promotion : validates
OrdersService ..> Order : creates Order & OrderItems
OrderService ..> OrderStatusHistory : records transitions
HistoryService ..> Order : queries history
LoyaltyService ..> LoyaltyTransaction : logs points

note bottom of OrderService
  Invariant: Duy nhất OrderService.transition()
  được phép cập nhật Order.status (Optimistic Lock).
end note

note bottom of PricingService
  Invariant: Toàn bộ giá do PricingService
  tính độc lập từ DB, bỏ qua giá từ Client.
end note
@enduml
