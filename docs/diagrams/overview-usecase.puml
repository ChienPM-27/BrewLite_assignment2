@startuml usecase-overview
title Sơ Đồ Use Case Tổng Quát - Hệ Thống BrewLite

left to right direction

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam defaultFontSize 11
skinparam nodesep 25
skinparam ranksep 35

skinparam actor {
    BackgroundColor white
    BorderColor black
}

skinparam usecase {
    BackgroundColor white
    BorderColor black
}

' =========================
' ACTORS
' =========================

actor "Khách hàng" as Customer
actor "Hệ thống VNPay\n(Sandbox)" as VNPay

' =========================
' BREWLITE SYSTEM
' =========================

rectangle "Hệ thống BrewLite" {

    ' -------------------------
    ' AUTHENTICATION
    ' -------------------------
    package "Xác thực & Tài khoản" {
        usecase "Đăng ký tài khoản" as UC_Register
        usecase "Đăng nhập hệ thống" as UC_Login
    }


    ' -------------------------
    ' PRODUCT CATALOG
    ' -------------------------
    package "Danh mục sản phẩm" {
        usecase "Xem thực đơn đồ uống" as UC_Menu
        usecase "Lọc sản phẩm\n theo danh mục" as UC_Filter
        usecase "Tìm kiếm sản phẩm\n theo tên" as UC_Search
    }


    ' -------------------------
    ' PRODUCT DETAIL
    ' -------------------------
    package "Chi tiết sản phẩm" {
        usecase "Xem chi tiết sản phẩm" as UC_Detail
        usecase "Tùy biến món\n(Size & Topping)" as UC_Customize
        usecase "Thêm món vào giỏ hàng" as UC_AddCart
    }


    ' -------------------------
    ' CART
    ' -------------------------
    package "Giỏ hàng" {
        usecase "Xem giỏ hàng" as UC_ViewCart
        usecase "Cập nhật / Xóa món" as UC_EditCart
        usecase "Tiến hành đặt hàng" as UC_Checkout
    }


    ' -------------------------
    ' ORDER
    ' -------------------------
    package "Đặt hàng" {
        usecase "Tạo đơn hàng" as UC_CreateOrder
 
    }


    ' -------------------------
    ' PAYMENT
    ' -------------------------
    package "Thanh toán" {
        usecase "Chọn phương thức thanh toán" as UC_PaymentMethod
        usecase "Thực hiện thanh toán" as UC_Payment
        usecase "Thanh toán mô phỏng" as UC_MockPayment
        usecase "Thanh toán qua VNPay" as UC_VNPayPayment
        usecase "Xem trạng thái hóa đơn" as UC_InvoiceStatus
    }


    ' -------------------------
    ' ORDER HISTORY
    ' -------------------------
    package "Lịch sử đơn hàng" {
        usecase "Xem lịch sử đơn hàng" as UC_History
        usecase "Xem chi tiết đơn hàng" as UC_OrderDetail
        usecase "Lọc theo trạng thái\nđơn hàng" as UC_FilterHistory
    }
}


' =========================
' CUSTOMER ASSOCIATIONS
' =========================

Customer --> UC_Register
Customer --> UC_Login

Customer --> UC_Menu
Customer --> UC_Filter
Customer --> UC_Search

Customer --> UC_Detail
Customer --> UC_Customize
Customer --> UC_AddCart

Customer --> UC_ViewCart
Customer --> UC_EditCart
Customer --> UC_Checkout

Customer --> UC_CreateOrder

Customer --> UC_PaymentMethod
Customer --> UC_Payment
Customer --> UC_InvoiceStatus

Customer --> UC_History
Customer --> UC_OrderDetail



' =========================
' INCLUDE / EXTEND
' =========================

' Product Catalog
UC_Filter ..> UC_Menu : <<extend>>
UC_Search ..> UC_Menu : <<extend>>

' Product Detail
UC_Customize ..> UC_Detail : <<extend>>



' Payment
UC_Payment ..> UC_PaymentMethod : <<include>>
UC_MockPayment ..> UC_PaymentMethod : <<extend>>
UC_VNPayPayment ..> UC_PaymentMethod : <<extend>>

VNPay --> UC_VNPayPayment

' Order History
UC_FilterHistory ..> UC_History : <<extend>>

' =========================
' LAYOUT SUPPORT
' =========================

UC_Register -[hidden]down-> UC_Login

UC_Menu -[hidden]down-> UC_Detail
UC_Detail -[hidden]down-> UC_ViewCart
UC_ViewCart -[hidden]down-> UC_CreateOrder
UC_CreateOrder -[hidden]down-> UC_Payment
UC_Payment -[hidden]down-> UC_History

@enduml