@startuml deployment-production
title Deployment Diagram - BrewLite

skinparam shadowing false
skinparam defaultFontName Arial
skinparam monochrome true
skinparam componentStyle rectangle

actor "Khách hàng\n(Browser)" as Customer

node "Vercel (Frontend Hosting)" {
    artifact "Next.js Web" as Web
}

node "Render (Backend Hosting)" {
    artifact "NestJS API" as API

    component "Payments Module" as Payments
    component "MockGatewayService" as Mock
    component "VnpayGatewayService" as Vnpay
    component "Orders Module" as Orders
    component "Loyalty Module" as Loyalty
}

database "Supabase (PostgreSQL)" as DB
cloud "VNPay Sandbox" as VNPay

Customer --> Web : HTTPS
Web --> API : REST API (Bearer JWT)
Customer --> VNPay : Redirect thanh toán (paymentUrl)
VNPay --> Customer : Return URL (Redirect về Frontend)
VNPay --> Vnpay : IPN Callback (Server-to-Server)

API --> Payments
Payments --> Mock
Payments --> Vnpay
Payments --> Orders
Payments --> Loyalty

Orders --> DB
Payments --> DB
Loyalty --> DB

note right of Vnpay
  - Create signed paymentUrl
  - Verify HMAC-SHA512 on IPN
  - Handle duplicate IPN safely
end note

note bottom of API
  Environment:
  VNPAY_URL
  VNPAY_TMN_CODE
  VNPAY_HASH_SECRET
  VNPAY_RETURN_URL

  Hash Secret: Backend only
end note

note bottom of VNPay
  Local: Public tunnel URL (ngrok)
  Render: Public Backend URL
end note

@enduml