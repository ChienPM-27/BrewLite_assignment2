
@startuml sequence-checkout
title Sequence Diagram - Checkout & Payment (BrewLite)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor black
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ActorBorderColor black
    ActorBackgroundColor white
}

actor "Khách hàng" as Customer
participant "Frontend\nNext.js" as FE
participant "Backend\nNestJS API" as BE
database "PostgreSQL" as DB
participant "MockGatewayService" as Mock
participant "VnpayGatewayService" as Vnpay
participant "VNPay Sandbox" as VNPay
participant "LoyaltyService" as Loyalty

== Tạo đơn hàng ==

Customer -> FE: Xác nhận đặt hàng
FE -> BE: POST /api/v1/orders
BE -> BE: Validate dữ liệu và tính giá
BE -> DB: Transaction: trừ nguyên liệu,\ntạo Order PENDING
DB --> BE: Order created
BE --> FE: 201 Created\norderId, orderNumber, finalAmount
FE --> Customer: Hiển thị trang thanh toán

== Tạo yêu cầu thanh toán ==

Customer -> FE: Chọn phương thức và xác nhận
FE -> FE: Sinh Idempotency-Key (UUID)
FE -> BE: POST /api/v1/payments\nIdempotency-Key

BE -> DB: Kiểm tra Idempotency-Key
DB --> BE: Kết quả kiểm tra

alt Key đã tồn tại, cùng nội dung
    BE --> FE: Trả kết quả thanh toán đã lưu
else Key đã tồn tại, khác nội dung
    BE --> FE: 409 Conflict
else Key mới hợp lệ
    BE -> DB: Tạo Payment PENDING

    alt Gateway = MOCK
        BE -> Mock: Xử lý thanh toán mô phỏng
        Mock --> BE: SUCCESS / FAILED
        BE -> BE: Xử lý kết quả thanh toán
    else Gateway = VNPAY
        BE -> Vnpay: Tạo payment URL
        Vnpay --> BE: paymentUrl
        BE --> FE: Trả paymentUrl
        FE -> Customer: Chuyển trình duyệt sang VNPay
        Customer -> VNPay: Thực hiện thanh toán

        VNPay --> FE: Return URL
        FE --> Customer: Quay về trang kết quả\nChưa xác nhận thanh toán

        VNPay -> Vnpay: IPN Callback
        Vnpay -> Vnpay: Xác minh HMAC-SHA512
        Vnpay -> DB: Kiểm tra giao dịch và trạng thái

        alt IPN hợp lệ, giao dịch thành công
            Vnpay -> BE: Kết quả SUCCESS đã xác minh
        else IPN hợp lệ, giao dịch thất bại
            Vnpay -> BE: Kết quả FAILED đã xác minh
        else Chữ ký sai hoặc dữ liệu không khớp
            Vnpay --> VNPay: Từ chối thông báo
        end
    end

    alt Thanh toán thành công đã xác nhận
        BE -> DB: Payment SUCCESS
        BE -> DB: Order PENDING -> PAID\nGhi paid_at và lịch sử
        BE -> Loyalty: award(order)
        Loyalty -> DB: Ghi điểm thưởng một lần
        BE --> FE: Trạng thái PAID
        FE -> Customer: Hiển thị xác nhận đơn hàng
        FE -> FE: Xóa giỏ hàng
    else Thanh toán thất bại đã xác nhận
        BE -> DB: Payment FAILED
        BE -> DB: Order -> PAYMENT_FAILED
        BE --> FE: Trạng thái PAYMENT_FAILED
        FE -> Customer: Hiển thị Thử lại / Hủy đơn
        note over FE,DB
            Giữ nguyên liệu và giỏ hàng.
            Thử lại phải dùng Idempotency-Key mới.
        end note
    end
end

@enduml
