    {
      "name": "3. Orders",
      "item": [
        {
          "name": "3.1 Create Order (POST /orders)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"size\": \"M\",\n      \"quantity\": 1,\n      \"toppingIds\": []\n    }\n  ],\n  \"promotionCode\": \"WELCOME10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.environment.set('order_id', res.data.id);",
                  "    pm.environment.set('order_number', res.data.orderNumber);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Get My Orders History (GET /orders/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/me?page=1&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "me"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.3 Get Order Detail (GET /orders/:id)",
