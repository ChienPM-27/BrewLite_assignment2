			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"TC-DETAIL-05 (AC-09.5): Backend bảo vệ tính toàn vẹn giá - Chặn giá giả mạo\", function () {",
							"    pm.expect([201, 400]).to.include(pm.response.code);",
							"});",
							"const res = pm.response.json();",
							"if (pm.response.code === 400) {",
							"    pm.test(\"TC-DETAIL-05: ValidationPipe phát hiện và chặn đứng trường giá lậu (unitPrice/totalAmount)\", function () {",
							"        const msg = JSON.stringify(res.message);",
							"        pm.expect(msg).to.match(/should not exist|không hợp lệ/i);",
							"    });",
							"    console.log(\"BẢO MẬT TUYỆT ĐỐI: NestJS ValidationPipe chặn đứng field giá lậu với HTTP 400!\");",
							"} else if (pm.response.code === 201) {",
							"    const order = res.data;",
							"    pm.test(\"TC-DETAIL-05: PricingService tự đọc DB và tính giá thật (> 10.000đ)\", function () {",
							"        pm.expect(Number(order.totalAmount)).to.be.above(10000);",
							"        pm.expect(Number(order.totalAmount)).to.not.equal(2);",
							"    });",
							"    console.log(\"BẢO MẬT THÀNH CÔNG: PricingService tính đúng giá gốc:\", order.totalAmount, \"VNĐ\");",
							"}"
