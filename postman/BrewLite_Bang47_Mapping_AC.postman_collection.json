							"pm.test(\"TC-DETAIL-03: Size S có phụ thu 0đ (mặc định trên UI)\", function () {",
							"    const sizeS = sizePrices.find(sp => sp.size === 'S');",
							"    pm.expect(sizeS.priceAdjustment).to.equal(0);",
							"});",
							"pm.test(\"TC-DETAIL-03: Sắp xếp phụ thu tăng dần (S <= M <= L)\", function () {",
							"    for (let i = 0; i < sizePrices.length - 1; i++) {",
							"        pm.expect(sizePrices[i].priceAdjustment).to.be.at.most(sizePrices[i + 1].priceAdjustment);",
